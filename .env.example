PORT=3000
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nedecen
# Generate a private random secret; never use this example text in production.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Use none only for cross-site HTTPS frontend/API deployments, or keep lax for same-site.
AUTH_COOKIE_SAME_SITE=lax
# Set to the verified number of trusted reverse proxies on your hosting platform.
# TRUST_PROXY_HOPS=1
